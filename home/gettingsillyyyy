<!DOCTYPE html>
<html>
<head>
<title>It's Cable Two</title>

<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;700&display=swap" rel="stylesheet">

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="/load.js"></script>

<style>

/* BASE */
body {
  margin: 0;
  font-family: 'IBM Plex Mono', monospace;
  background: #e74c3c;
}

/* TOP AD */
.top-ad img {
  width: 100%;
  display: block;
}

/* MAIN LAYOUT */
.container {
  display: flex;
}

/* LEFT SIDE (MAIN) */
.left {
  width: 75%;
}

/* RIGHT SIDEBAR */
.right {
  width: 25%;
  background: #f4f4f4;
  padding: 15px;
}

/* BIG VIDEO */
.hero-video {
  position: relative;
  background: black;
}

.hero-video iframe {
  width: 100%;
  height: 400px;
  border: none;
}

/* LIVE BAR */
.live-bar {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: black;
  color: white;
  padding: 10px;
  font-weight: bold;
}

.live {
  background: red;
  padding: 3px 8px;
  margin-right: 10px;
}

/* TICKER */
.ticker {
  background: hotpink;
  color: white;
  padding: 8px;
  font-size: 12px;
  white-space: nowrap;
  overflow: hidden;
}

/* RED CONTENT AREA */
.red-section {
  padding: 20px;
}

/* FEATURE BLOCK */
.feature {
  display: flex;
  gap: 20px;
  margin-bottom: 20px;
}

.feature img {
  width: 150px;
}

.feature-text h2 {
  margin: 0;
  font-size: 28px;
}

/* GRID TILES */
.grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 15px;
}

.tile img {
  width: 100%;
  display: block;
}

.tile-title {
  font-size: 12px;
  margin-top: 5px;
}

/* SIDEBAR */
.sidebar-item {
  margin-bottom: 20px;
}

.sidebar-item img {
  width: 100%;
}

.sidebar-title {
  font-weight: bold;
  font-size: 12px;
  margin-top: 5px;
}

/* QUOTE BOX */
.quote {
  border-top: 2px solid black;
  border-bottom: 2px solid black;
  padding: 20px;
  margin: 20px 0;
  font-size: 18px;
}

/* FOOTER */
.footer {
  text-align: center;
  font-size: 12px;
  padding: 40px;
}

a { color: inherit; }

</style>
</head>

<body>

<!-- TOP AD -->
<div class="top-ad">
  <a href="https://www.youtube.com/watch?v=ee9jZ04Zrqo" target="_blank">
    <img src="https://64.media.tumblr.com/ec5486e2b351d11479fcc1cf14abefc2/5a2e1bf7bdd4f80a-63/s1280x1920/c6327d3e54a2da0ed4a14991ec69528fe13a6573.pnj">
  </a>
</div>

<!-- HEADER -->
<div id="header"></div>

<div class="container">

  <!-- LEFT -->
  <div class="left">

    <!-- HERO VIDEO -->
    <div class="hero-video">
      <iframe src="https://www.youtube.com/embed/f-Q5_8td_pU"></iframe>

      <div class="live-bar">
        <span class="live">LIVE</span>
        FISCHCENTER LIVE — CALL NOW: 708-SWIM-FUN
      </div>
    </div>

    <!-- TICKER -->
    <div class="ticker">
      NEW SHOWS • LIVE CHAOS • CABLE TWO • COMMUNITY TV • STREAM FOREVER •
    </div>

    <!-- RED SECTION -->
    <div class="red-section">

      <!-- FEATURE -->
      <div class="feature">
        <img src="https://cabletwo.net/home/sphere.gif">
        <div class="feature-text">
          <h2>CABLE TWO</h2>
          <p>
            Cable Two isn't a name. It's a threat and a promise.
            Watch live on <a href="https://twitch.tv/cabletwo">Twitch</a>.
          </p>
        </div>
      </div>

      <!-- GRID -->
      <div class="grid">

        <div class="tile">
          <img src="https://64.media.tumblr.com/9ca221f88b9a7e1e879af1446f8e2083/0a093f23428e0831-fb/s1280x1920/9ac3d2cda8f84bb22704a227e9b44d685f6cd332.pnj">
          <div class="tile-title">NEWS UPDATE</div>
        </div>

        <div class="tile">
          <img src="https://64.media.tumblr.com/46f44bf442ac83d121e9152ff24197c5/762f0c000a2a8d52-d5/s640x960/59eaa6d1c0701b27a7358a83b17d28a824582020.pnj">
          <div class="tile-title">LIVE SHOWS</div>
        </div>

        <div class="tile">
          <img src="https://64.media.tumblr.com/bffd2c223393aa7ea371f8f01c10fa96/0a093f23428e0831-ca/s1280x1920/c0c8a4dc9db5e02765c4f0a717d4a69555e54fdb.pnj">
          <div class="tile-title">SHOP</div>
        </div>

      </div>

    </div>

  </div>

  <!-- RIGHT SIDEBAR -->
  <div class="right">

    <div class="sidebar-item">
      <img src="https://64.media.tumblr.com/46f44bf442ac83d121e9152ff24197c5/762f0c000a2a8d52-d5/s640x960/59eaa6d1c0701b27a7358a83b17d28a824582020.pnj">
      <div class="sidebar-title">THE HEART, SHE HOLLER</div>
    </div>

    <div class="sidebar-item">
      <img src="https://64.media.tumblr.com/9ca221f88b9a7e1e879af1446f8e2083/0a093f23428e0831-fb/s1280x1920/9ac3d2cda8f84bb22704a227e9b44d685f6cd332.pnj">
      <div class="sidebar-title">MIKE TYSON MYSTERIES</div>
    </div>

    <div class="quote">
      "THAT'S RIGHT, GIRL, GET YOURSELF CLEAN."
    </div>

    <div class="sidebar-item">
      <div class="sidebar-title">CONNECT</div>
      <p>
        <a href="https://discord.gg/g7NfZzWQXe">Discord</a><br>
        <a href="https://twitch.tv/cabletwo">Twitch</a><br>
        <a href="https://instagram.com/cabletwo">Instagram</a>
      </p>
    </div>

  </div>

</div>

<!-- CAROUSEL -->
<center><div id="carousel"></div></center>

<!-- FOOTER -->
<div class="footer">
  © Cable Two
</div>

</body>
</html>
